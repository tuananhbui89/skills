{
  "name": "learning-log-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:build": "node --experimental-strip-types --experimental-specifier-resolution=node ./scripts/build-content.ts",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build:app": "node ./node_modules/vite/bin/vite.js build",
    "build": "npm run content:build && npm run build:app",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "npm run content:build && node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
